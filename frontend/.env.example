# Backend origin for server-side requests and the dev proxy.
# Docker: http://backend:8000 — bare local dev may omit it (defaults to :8000).
INTERNAL_API_HOST=
BETTER_AUTH_SECRET=""
# Public base URL / identity of the frontend (OAuth callbacks, cookie flags).
BETTER_AUTH_URL="https://yourdomain.com"
BETTER_AUTH_MICROSOFT_CLIENT_ID=
BETTER_AUTH_MICROSOFT_CLIENT_SECRET=
BETTER_AUTH_MICROSOFT_TENANT_ID=
